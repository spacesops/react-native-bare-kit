{
  "name": "@spacesops/react-native-bare-kit",
  "version": "0.11.0-beta.44",
  "description": "Bare Kit for React Native (Spacesops fork with nested addon linking)",
  "main": "./index.js",
  "types": "./index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "react-native.config.js",
    "*.podspec",
    "android",
    "ios",
    "shared",
    "specs"
  ],
  "scripts": {
    "test": "prettier . --check",
    "sync-native": "node scripts/sync-holepunch-native.mjs",
    "verify-pack": "node scripts/verify-pack-includes-native.mjs",
    "prepack": "node scripts/sync-holepunch-native.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spacesops/react-native-bare-kit.git"
  },
  "author": "Spacesops",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/spacesops/react-native-bare-kit/issues"
  },
  "homepage": "https://github.com/spacesops/react-native-bare-kit#readme",
  "codegenConfig": {
    "name": "BareKitSpec",
    "type": "modules",
    "jsSrcsDir": "specs",
    "android": {
      "javaPackageName": "to.holepunch.bare.kit.react"
    },
    "ios": {
      "modulesConformingToProtocol": "RCTTurboModule",
      "modulesProvider": {
        "BareKit": "BareKitModuleProvider"
      }
    }
  },
  "dependencies": {
    "bare-events": "^2.6.1",
    "bare-link": "^2.1.2",
    "bare-lief": "^0.1.0",
    "streamx": "^2.21.0"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "prettier-config-holepunch": "^2.0.0"
  }
}
